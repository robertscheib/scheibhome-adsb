######################################################################################################################################
# ADS-B Stack — Environment Variables
# Copy this file to .env and fill in your values before running docker compose up.
# Guide: https://sdr-enthusiasts.gitbook.io/ads-b
######################################################################################################################################

###############################################################################
# Station Location & Identity
###############################################################################
FEEDER_NAME=Home
FEEDER_LAT=41.0000          # Decimal degrees, North positive
FEEDER_LONG=-88.0000        # Decimal degrees, East positive
FEEDER_ALT_M=200            # Antenna altitude above MSL in metres
FEEDER_ALT_FT=656           # Same altitude in feet (ALT_M * 3.28084)
FEEDER_TZ=America/Chicago   # TZ database name: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones

###############################################################################
# Primary ADS-B SDR (1090 MHz) — serial must match your dongle
###############################################################################
ADSB_SDR_SERIAL=1090        # Set via: rtl_test / rtl_eeprom -d 0
ADSB_SDR_GAIN=autogain      # autogain or a numeric value (e.g. 43.9)
ADSB_SDR_PPM=0              # Frequency correction in ppm (0 if TCXO)

###############################################################################
# Ultrafeeder
# Generate UUID with: cat /proc/sys/kernel/random/uuid
###############################################################################
ULTRAFEEDER_UUID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

###############################################################################
# HeyWhatsThat — coverage panorama (optional but recommended)
# Create at: https://www.heywhatsthat.com
###############################################################################
FEEDER_HEYWHATSTHAT_ID=XXXXXXXX
FEEDER_HEYWHATSTHAT_ALTS=3000,12000  # Feet — comma-separated altitudes for overlay rings

###############################################################################
# Feeder Keys — obtain from each service's website
###############################################################################

# FlightAware PiAware — https://flightaware.com/adsb/piaware/claim
PIAWARE_FEEDER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# FlightRadar24 — run: docker exec fr24 fr24feed --signup
FR24_SHARING_KEY=your_fr24_sharing_key
FR24_RADAR_ID=T-XXXX0       # Assigned by FR24 after signup
FR24KEY_UAT=                 # USA only, leave empty if no dump978
ICECAST_SOURCE_PASSWORD=     # required only when the disabled airband profile is enabled
ICECAST_ADMIN_PASSWORD=      # required only when the disabled airband profile is enabled

# PlaneFinder — https://planefinder.net/account/receivers
PLANEFINDER_SHARECODE=your_planefinder_sharecode

# AirNav RadarBox — https://www.radarbox.com/stations
AIRNAVRADAR_SHARING_KEY=your_airnavradar_sharing_key

# RadarVirtuel — https://www.radarvirtuel.com/en/my-station
# Format: stationcode:HEXKEY
RV_FEEDER_KEY=xxxx:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
RV_KEY=xxxx:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX        # Same value as RV_FEEDER_KEY

# Plane.Watch — https://plane.watch/profile/api-keys
PLANEWATCH_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PW_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx     # Same value as PLANEWATCH_KEY

# ADSBHub — https://www.adsbhub.org/howtofeed.php
ADSBHUB_STATION_KEY=your_adsbhub_station_key

# ADSB.fi — UUID auto-generated; see ultrafeeder logs on first run
ADSBFI_UUID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ADSB.lol — UUID auto-generated; see ultrafeeder logs on first run
ADSBLOL_UUID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ADSBExchange
ADSBEx=your_adsbexchange_key

# ADSBiq — https://adsbiq.com/install/advanced
ADSBIQ_UUID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ADSBIQ_API_TOKEN=iq_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AvioADSB — https://avioadsb.org/dashboard
# Used by the official host-installed feeder, not interpolated by Compose.
AVIOADSB_RECEIVER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AVIOADSB_TOKEN=your_avioadsb_station_token

# OpenSky Network — https://opensky-network.org
OPENSKY_USERNAME=your_opensky_username
OPENSKY_SERIAL=             # Auto-assigned; leave empty on first run

###############################################################################
# Virtual Radar Server (VRS)
###############################################################################
VRS_ADMIN_USERNAME=admin
VRS_ADMIN_PASSWORD=change_me_strong_password

###############################################################################
# ACARS / VDLM2 — second SDR required; leave as-is if disabled
###############################################################################
ACARS_SDR_SERIAL=acars
ACARS_SDR_GAIN=autogain
ACARS_SDR_PPM=0
ACARS_FREQUENCIES=130.025,130.450,131.125,131.550
ACARS_FEEDER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

VDLM_SDR_SERIAL=vdlm
VDLM_SDR_GAIN=autogain
VDLM_SDR_PPM=0
VDLM_FREQUENCIES=136.650,136.800,136.900,136.975
VDLM_FEEDER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

###############################################################################
# UAT 978 MHz — second SDR required; leave as-is if disabled (non-USA: ignore)
###############################################################################
UAT_SDR_SERIAL=978
UAT_SDR_GAIN=autogain
UAT_SDR_PPM=0
FR24KEY_UAT=

###############################################################################
# Multifeeder (optional)
###############################################################################
Multifeeder=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
